# Opportunity Analytics Service Configuration

# Database
HOLOCRON_DSN=postgres://fortuna:fortuna_dev_password@holocron:5432/holocron?sslmode=disable

# Redis
REDIS_URL=redis:6379
REDIS_PASSWORD=reddis_pw

# Stream Configuration
STREAM_KEY=opportunities.detected
CONSUMER_GROUP=opportunity-analytics
CONSUMER_ID=analytics-1

# Service Configuration
FLUSH_INTERVAL=60s
BUCKET_RESOLUTION=5m
PORT=8091

# Game Status Filtering
# Set to true to exclude live/in-progress games from analytics tracking
# Only pregame opportunities will be tracked when true
EXCLUDE_LIVE_GAMES=true

# Logging
LOG_LEVEL=info

